# Copy to .env. Keys stay on the server; the browser never sees them.
# Admin sign-in at /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
# Signs admin sessions; any long random string. Keeps editors signed in across restarts.
SECRET_KEY=change-me-to-a-long-random-string
# Optional bearer token for scripts calling the admin API
ADMIN_TOKEN=
POSTGRES_PASSWORD=change-me

# News providers (leave empty to keep a provider off)
GNEWS_API_KEY=
WORLDNEWS_API_KEY=
NEWSAPI_KEY=
# NewsAPI's free Developer plan forbids production use. Set true only on a paid plan.
NEWSAPI_PRODUCTION_PLAN=false

# Humanitarian data
# HDX HAPI: an app identifier (not a secret) = base64("app name:email").
# Give it directly, or the two parts and the server builds it.
HDX_APP_IDENTIFIER=
HDX_APP_NAME=
HDX_APP_EMAIL=
# ReliefWeb API v2: an application name ReliefWeb has approved (request it first).
RELIEFWEB_APPNAME=
DTM_SUBSCRIPTION_KEY=
ACLED_USERNAME=
ACLED_PASSWORD=

# Schedule (minutes). Keep within each provider's plan limits.
# Hourly by default. The scheduler runs in the API process unless
# SCHEDULER_ENABLED=false (docker-compose gives it to the worker instead).
NEWS_INTERVAL_MINUTES=60
METRICS_INTERVAL_MINUTES=60
RATE_LIMIT_PER_MINUTE=120
SEARCH_RATE_LIMIT_PER_MINUTE=30
